# Mobu environment variables
# Copy this to .env.local and fill in real values for local development.
# (npx convex dev writes VITE_CONVEX_URL here automatically on first run.)

VITE_CONVEX_URL=

# Google Maps JavaScript + Geocoding API key, used by the Relationship Map
# and "use current location" on memories. The map shows a "not connected"
# placeholder until this is set — everything else in the app works without it.
VITE_GOOGLE_MAPS_API_KEY=

# Optional private TURN relay for calls. Leaving these blank is fine — the app
# falls back to Open Relay, Metered's free public TURN service, which needs no
# account. A relay is what makes calls connect across mobile carrier NAT, so
# there is always one configured.
#
# For something more dependable than a shared free relay, Cloudflare Realtime
# has a free tier (no card required): create a TURN key in the Cloudflare
# dashboard under Realtime > TURN, then paste the values here.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
