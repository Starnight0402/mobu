{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n vite,convex -c blue,magenta \"vite\" \"convex dev\"",
    "dev:frontend": "vite",
    "dev:backend": "convex dev",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project convex",
    "test:watch": "vitest --project unit --project convex",
    "test:coverage": "vitest run --project unit --project convex --coverage",
    "test:perf": "vitest run --project perf",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/check-bundle.mjs",
    "verify": "npm run typecheck && npm test && npm run test:perf && npm run build && npm run check:bundle"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@capacitor/android": "^8.5.0",
